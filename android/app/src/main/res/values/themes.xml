        <item name="colorOnPrimary">@android:color/white</item>
        <item name="android:statusBarColor">@color/theme_green_status</item>
    </style>

    <!-- 橙色 -->
    <style name="Theme.RemoteControl.Orange" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/theme_orange_primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="android:statusBarColor">@color/theme_orange_status</item>
    </style>

    <!-- 深色 -->
    <style name="Theme.RemoteControl.Night" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/theme_night_primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="android:statusBarColor">@color/theme_night_status</item>
    </style>
</resources>